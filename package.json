{
  "name": "autogoals",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev:cli": "pnpm --filter @autogoals/cli dev",
    "dev:api": "COREPACK_ENABLE_STRICT=0 pnpm --filter @autogoals/api dev",
    "dev:dashboard": "COREPACK_ENABLE_STRICT=0 pnpm --filter @autogoals/dashboard dev",
    "dev:docs": "COREPACK_ENABLE_STRICT=0 pnpm --filter @autogoals/docs dev"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
