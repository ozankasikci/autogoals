{
  "name": "small-singularity",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev:cli": "pnpm --filter @small-singularity/cli dev",
    "dev:api": "COREPACK_ENABLE_STRICT=0 pnpm --filter @small-singularity/api dev",
    "dev:dashboard": "COREPACK_ENABLE_STRICT=0 pnpm --filter @small-singularity/dashboard dev"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
